# TON Network
TON_ENDPOINT=https://toncenter.com/api/v2/jsonRPC
TON_API_KEY=your_toncenter_api_key_here

# Indexer Config
POLLING_INTERVAL_MS=4000
START_FROM_LT=0

# Contracts (fill after deployment)
BONDING_CURVE_ADDRESS=

# Database (optional - uses memory if not set)
DATABASE_URL=postgresql://user:pass@localhost:5432/tonpump
REDIS_URL=redis://localhost:6379

# Server
PORT=3001
